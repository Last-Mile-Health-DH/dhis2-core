DHIS2_IMAGE=dhis2/core-dev:latest

DORIS_VERSION=3.0.7

DB_HOSTNAME=db
DB_NAME=dhis
DB_USERNAME=dhis
DB_PASSWORD=dhis

# Leave as localhost for HTTPS via Caddy's internal CA, or set a real domain for ACME/Let's Encrypt
DOMAIN=localhost

# Skip the demo DB dump and start with an empty database
LOAD_DEMO_DATA=false

# Applied to the default admin user once DHIS2 is up (see README: Custom admin credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
